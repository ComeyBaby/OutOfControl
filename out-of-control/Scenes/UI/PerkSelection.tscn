[sub_resource type="ShaderMaterial" id="ShaderMaterial_wq04g"]
shader = ExtResource("5_c3s5p")
shader_parameter/blur_lod = 3.0000000447036
shader_parameter/dim_strength = 0.749999983236

[sub_resource type="Shader" id="Shader_lava_overlay"]
code = "shader_type canvas_item;
render_mode blend_premul_alpha;

uniform vec4 color_dark : source_color = vec4(0.2, 0.1, 0.08, 0.16);
uniform vec4 color_bright : source_color = vec4(0.95, 0.35, 0.08, 0.26);
uniform float speed = 0.45;
uniform float scale = 5.5;
uniform float contrast = 0.75;
uniform vec2 rect_size = vec2(260.0, 320.0);
uniform float corner_radius_px = 16.0;
uniform float inset_px = 2.0;
uniform float edge_softness_px = 1.25;

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	float a = hash(i);
	float b = hash(i + vec2(1.0, 0.0));
	float c = hash(i + vec2(0.0, 1.0));
	float d = hash(i + vec2(1.0, 1.0));
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

float fbm(vec2 p) {
	float value = 0.0;
	float amplitude = 0.5;
	for (int i = 0; i < 4; i++) {
		value += amplitude * noise(p);
		p *= 2.0;
		amplitude *= 0.5;
	}
	return value;
}

float rounded_rect_sdf(vec2 p, vec2 half_size, float radius) {
	vec2 q = abs(p) - (half_size - vec2(radius));
	return length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - radius;
}

float rounded_mask(vec2 uv) {
	vec2 safe_size = max(rect_size, vec2(1.0));
	float radius = clamp(corner_radius_px, 0.0, min(safe_size.x, safe_size.y) * 0.5 - inset_px);
	vec2 half_size = safe_size * 0.5 - vec2(inset_px);
	vec2 point = uv * safe_size - safe_size * 0.5;
	float outside = rounded_rect_sdf(point, half_size, radius);
	return 1.0 - smoothstep(0.0, edge_softness_px, outside);
}

void fragment() {
	vec2 uv = UV * scale;
	float t = TIME * speed;

	float n1 = fbm(uv + vec2(t, -t * 0.7));
	float n2 = fbm(uv * 1.6 + vec2(-t * 1.2, t * 0.9));
	float lava = clamp((n1 * 0.65 + n2 * 0.55) * contrast, 0.0, 1.0);
	lava = smoothstep(0.25, 0.8, lava);

	vec4 col = mix(color_dark, color_bright, lava);
	float mask = rounded_mask(UV);
	col.a *= mask;
	col.rgb *= col.a;
	COLOR = col;
}
"

